# This board ships an early ESP32-P4 silicon revision (v1.3). The IDF default
# minimum of v3.1 makes the bootloader refuse to flash.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16m.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_16m.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_250M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_CACHE_L2_CACHE_128KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
# This board exposes only a CH340 UART bridge; the P4 USB-Serial-JTAG pins are
# not brought out, so the console must stay on UART0 or no log is visible.
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# Brookesia:Hal:Adaptor
# System
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_SYSTEM_DEVICE=y
# System:BoardInfo
CONFIG_BROOKESIA_HAL_ADAPTOR_SYSTEM_ENABLE_BOARD_INFO_IMPL=y
# Network
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_NETWORK_DEVICE=y
# Network:SntpClient
CONFIG_BROOKESIA_HAL_ADAPTOR_NETWORK_ENABLE_SNTP_CLIENT_IMPL=y
# Network:HttpClient
CONFIG_BROOKESIA_HAL_ADAPTOR_NETWORK_ENABLE_HTTP_CLIENT_IMPL=y
CONFIG_LWIP_SNTP_MAX_SERVERS=4
CONFIG_LWIP_SNTP_STARTUP_DELAY=n
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_DHCP_MAX_NTP_SERVERS=4
# Audio
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_AUDIO_DEVICE=y
# Audio:CodecPlayer
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_ENABLE_CODEC_PLAYER_IMPL=y
# Audio:CodecRecorder
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_ENABLE_CODEC_RECORDER_IMPL=y
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_CODEC_RECORDER_BITS=16
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_CODEC_RECORDER_CHANNELS=2
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_CODEC_RECORDER_SAMPLE_RATE=16000
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_CODEC_RECORDER_MIC_LAYOUT="MR"
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_CODEC_RECORDER_GENERAL_GAIN="36.0"
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_CODEC_RECORDER_CHANNEL_GAINS="{}"
# Audio:Processor
CONFIG_BROOKESIA_HAL_ADAPTOR_AUDIO_ENABLE_PROCESSOR_IMPL=y
CONFIG_AUDIO_SIMPLE_PLAYER_RESAMPLE_DEST_RATE=16000
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_CH_CVT_EN=y
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_BIT_CVT_EN=y
CONFIG_AUDIO_SIMPLE_PLAYER_BIT_CVT_DEST_16BIT=y
# Video
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
# 1920x1080@30 pushes about 62 MP/s, and the ISP wants roughly twice that.
# The P4 sources the ISP from PLL_F240M, so 240 MHz divides by one.
CONFIG_ESP_VIDEO_ISP_CLK_FREQ_MHZ=240
# The fitted module answers at 7-bit 0x36 with chip ID 0x5602 (registers
# 0x300A/0x300B), which identifies an OV02C10. The vendor BSP documents an
# SC2336 at 0x30; nothing answers there on this board.
CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
# CAMERA_OV02C10_MIPI_DEFAULT_FMT is a Kconfig choice, so exactly one default
# format applies. 1920x1080 RAW10 at 30fps streams roughly 622 Mbps and drowns
# the ISP in "fifo overflow" errors, dropping every frame, while the preview
# sink is only 640x480 anyway. The 1288x728 mode carries about 281 Mbps and
# leaves ample headroom above what the preview actually consumes.
CONFIG_CAMERA_OV02C10_MIPI_RAW10_1920x1080_30FPS=y
# Enabling AF makes the driver drive extra IO pins for a VCM focus motor. It is
# unverified whether the module fitted here has one, and which pins those would
# be on this board, so AF stays off as the conservative choice. Preview works
# without it. Revisit if focus control is ever needed.
# CONFIG_CAMERA_OV02C10_ISP_AF_ENABLE is not set

# Video:Encoder
# The camera module is mounted turned 90 degrees relative to the panel, and
# neither the sensor nor the panel can compensate: JD9365 rejects swap_xy and
# the sensor only offers flip/mirror. The PPA rotates in hardware instead.
CONFIG_AV_PROCESSOR_VIDEO_ROTATION_DEGREE=90

CONFIG_BROOKESIA_HAL_ADAPTOR_VIDEO_ENABLE_ENCODER_IMPL=y
CONFIG_BROOKESIA_HAL_ADAPTOR_VIDEO_ENCODER_DEFAULT_NUM=1
# Video:Decoder
CONFIG_BROOKESIA_HAL_ADAPTOR_VIDEO_ENABLE_DECODER_IMPL=y
CONFIG_BROOKESIA_HAL_ADAPTOR_VIDEO_DECODER_DEFAULT_NUM=1
# Display
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_DISPLAY_DEVICE=y
# Display:LedcBacklight
CONFIG_BROOKESIA_HAL_ADAPTOR_DISPLAY_ENABLE_LEDC_BACKLIGHT_IMPL=y
# Display:LcdPanel
CONFIG_BROOKESIA_HAL_ADAPTOR_DISPLAY_ENABLE_LCD_PANEL_IMPL=y
CONFIG_BROOKESIA_HAL_ADAPTOR_DISPLAY_LCD_PANEL_H_RES=800
CONFIG_BROOKESIA_HAL_ADAPTOR_DISPLAY_LCD_PANEL_V_RES=1280
# Display:LcdTouch
CONFIG_BROOKESIA_HAL_ADAPTOR_DISPLAY_ENABLE_LCD_TOUCH_IMPL=y
# Storage
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_STORAGE_DEVICE=y
# Storage:KV
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_ENABLE_KEY_VALUE_IMPL=y
CONFIG_NVS_ALLOCATE_CACHE_IN_SPIRAM=y
# Storage:GeneralFs
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_ENABLE_FILE_SYSTEM_IMPL=y
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_FILE_SYSTEM_ENABLE_LITTLEFS=y
CONFIG_BROOKESIA_HAL_ADAPTOR_STORAGE_FILE_SYSTEM_ENABLE_SDCARD=y

# Every mounted filesystem and character device takes one of CONFIG_VFS_MAX_COUNT
# slots. With LittleFS, the SD card's FATFS, the UART console and the USB serial
# JTAG console all registered, the default of 8 leaves nothing for /dev/video0,
# and the camera fails with "Failed to register video VFS dev name=video0" while
# the sensor itself is detected fine.
CONFIG_VFS_MAX_COUNT=16
CONFIG_FATFS_LFN_HEAP=y
# WiFi
CONFIG_BROOKESIA_HAL_ADAPTOR_ENABLE_WIFI_DEVICE=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
