{
    "type": "viewScreen",
    "id": "display",
    "mountMode": "dynamic",
    "commonProps": {
        "scrollable": false
    },
    "styleRefs": [
        "app.page"
    ],
    "children": [
        {
            "type": "container",
            "id": "page",
            "commonProps": {
                "scrollable": true
            },
            "layout": {
                "type": "flex",
                "flexFlow": "column",
                "gap": "${constant.settings.layout.pageGap}"
            },
            "placement": {
                "mode": "absolute",
                "x": "${constant.settings.layout.pageX}",
                "y": "${constant.settings.layout.pageY}",
                "width": "${constant.settings.layout.pageWidth}",
                "height": "${constant.settings.layout.pageHeight}"
            },
            "children": [
                {
                    "type": "container",
                    "id": "theme_modes",
                    "layout": {
                        "type": "flex",
                        "flexFlow": "rowWrap",
                        "gap": "${constant.settings.layout.cardGap}",
                        "mainAlign": "start",
                        "crossAlign": "start"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap",
                        "alignSelf": "stretch"
                    },
                    "children": [
                        {
                            "type": "templateRef",
                            "id": "light_mode",
                            "templateId": "theme_mode_card",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.light"
                                        }
                                    ],
                                    "placement": {
                                        "mode": "flow",
                                        "alignSelf": "stretch"
                                    }
                                },
                                "preview": {
                                    "style": {
                                        "bgColor": "${color.bg.base}",
                                        "radius": "18dp"
                                    }
                                },
                                "label": {
                                    "labelProps": {
                                        "text": "Light mode"
                                    },
                                    "styleRefs": [
                                        "app.cardTitle"
                                    ],
                                    "bindings": {
                                        "labelProps.text": "labelProps.text",
                                        "style.textColor": "textColor"
                                    }
                                }
                            }
                        },
                        {
                            "type": "templateRef",
                            "id": "dark_mode",
                            "templateId": "theme_mode_card",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.dark"
                                        }
                                    ],
                                    "placement": {
                                        "mode": "flow",
                                        "alignSelf": "stretch"
                                    }
                                },
                                "preview": {
                                    "style": {
                                        "bgColor": "${color.bg.overlay}",
                                        "radius": "18dp"
                                    }
                                },
                                "label": {
                                    "labelProps": {
                                        "text": "Dark mode"
                                    },
                                    "styleRefs": [
                                        "app.cardTitle"
                                    ],
                                    "bindings": {
                                        "labelProps.text": "labelProps.text",
                                        "style.textColor": "textColor"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "label",
                    "id": "brightness_caption",
                    "styleRefs": [
                        "app.caption"
                    ],
                    "labelProps": {
                        "text": "Brightness level"
                    },
                    "placement": {
                        "mode": "flow"
                    },
                    "bindings": {
                        "labelProps.text": "labelProps.text"
                    }
                },
                {
                    "type": "templateRef",
                    "id": "brightness_card",
                    "templateId": "settings_card",
                    "overrides": {
                        ".": {
                            "style": {
                                "padding": "${constant.settings.layout.cardPadding}"
                            },
                            "layout": {
                                "gap": "${constant.settings.layout.cardGap}"
                            },
                            "placement": {
                                "mode": "flow",
                                "width": "match",
                                "height": "wrap",
                                "alignSelf": "stretch"
                            }
                        }
                    },
                    "slots": {
                        "content": [
                            {
                                "type": "templateRef",
                                "id": "brightness_row",
                                "templateId": "slider_row",
                                "overrides": {
                                    "title": {
                                        "labelProps": {
                                            "text": "Screen brightness"
                                        }
                                    },
                                    "slider": {
                                        "events": [
                                            {
                                                "type": "valueChanged",
                                                "action": "settings.display.brightness"
                                            }
                                        ],
                                        "rangeProps": {
                                            "min": 0,
                                            "max": 100,
                                            "value": 72
                                        }
                                    }
                                }
                            }
                        ]
                    }
                },
                {
                    "type": "label",
                    "id": "sleep_caption",
                    "styleRefs": [
                        "app.caption"
                    ],
                    "labelProps": {
                        "text": "Screen sleep"
                    },
                    "placement": {
                        "mode": "flow"
                    },
                    "bindings": {
                        "labelProps.text": "labelProps.text"
                    }
                },
                {
                    "type": "container",
                    "id": "sleep_card",
                    "styleRefs": [
                        "app.card"
                    ],
                    "style": {
                        "padding": "18dp"
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "gap": "0dp"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap",
                        "alignSelf": "stretch"
                    },
                    "children": [
                        {
                            "type": "templateRef",
                            "id": "sleep_15s",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.sleep.15s"
                                        }
                                    ]
                                },
                                "title_box/title": {
                                    "labelProps": {
                                        "text": "15 seconds"
                                    }
                                }
                            }
                        },
                        {
                            "type": "templateRef",
                            "id": "sleep_30s",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.sleep.30s"
                                        }
                                    ]
                                },
                                "title_box/title": {
                                    "labelProps": {
                                        "text": "30 seconds"
                                    }
                                }
                            }
                        },
                        {
                            "type": "templateRef",
                            "id": "sleep_1m",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.sleep.1m"
                                        }
                                    ]
                                },
                                "title_box/title": {
                                    "labelProps": {
                                        "text": "1 minute"
                                    }
                                }
                            }
                        },
                        {
                            "type": "templateRef",
                            "id": "sleep_2m",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.sleep.2m"
                                        }
                                    ]
                                },
                                "title_box/title": {
                                    "labelProps": {
                                        "text": "2 minutes"
                                    }
                                }
                            }
                        },
                        {
                            "type": "templateRef",
                            "id": "sleep_5m",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.sleep.5m"
                                        }
                                    ]
                                },
                                "title_box/title": {
                                    "labelProps": {
                                        "text": "5 minutes"
                                    }
                                }
                            }
                        },
                        {
                            "type": "templateRef",
                            "id": "sleep_10m",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.sleep.10m"
                                        }
                                    ]
                                },
                                "title_box/title": {
                                    "labelProps": {
                                        "text": "10 minutes"
                                    }
                                }
                            }
                        },
                        {
                            "type": "templateRef",
                            "id": "sleep_never",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.sleep.never"
                                        }
                                    ]
                                },
                                "title_box/title": {
                                    "labelProps": {
                                        "text": "Never"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "label",
                    "id": "schedule_caption",
                    "styleRefs": [
                        "app.caption"
                    ],
                    "labelProps": {
                        "text": "Scheduled screen off"
                    },
                    "placement": {
                        "mode": "flow"
                    },
                    "bindings": {
                        "labelProps.text": "labelProps.text"
                    }
                },
                {
                    "type": "container",
                    "id": "schedule_card",
                    "styleRefs": [
                        "app.card"
                    ],
                    "style": {
                        "padding": "18dp"
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "gap": "0dp"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap",
                        "alignSelf": "stretch"
                    },
                    "children": [
                        {
                            "type": "templateRef",
                            "id": "schedule_enable_row",
                            "templateId": "switch_row",
                            "overrides": {
                                "toggle": {
                                    "events": [
                                        {
                                            "type": "valueChanged",
                                            "action": "settings.display.schedule.toggle"
                                        }
                                    ]
                                },
                                "text/title": {
                                    "labelProps": {
                                        "text": "Enable schedule"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "label",
                    "id": "schedule_days_caption",
                    "styleRefs": [
