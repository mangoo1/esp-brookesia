                        {
                            "type": "templateRef",
                            "id": "schedule_day_saturday",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.schedule.day.saturday"
                                        }
                                    ]
                                },
                                "title_box/title": {
                                    "labelProps": {
                                        "text": "Saturday"
                                    }
                                }
                            }
                        },
                        {
                            "type": "templateRef",
                            "id": "schedule_day_sunday",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.schedule.day.sunday"
                                        }
                                    ]
                                },
                                "title_box/title": {
                                    "labelProps": {
                                        "text": "Sunday"
                                    }
                                }
                            }
                        }
                    ]
                },
                {
                    "type": "label",
                    "id": "schedule_start_caption",
                    "styleRefs": [
                        "app.caption"
                    ],
                    "labelProps": {
                        "text": "Start time"
                    },
                    "placement": {
                        "mode": "flow"
                    },
                    "bindings": {
                        "labelProps.text": "labelProps.text"
                    }
                },
