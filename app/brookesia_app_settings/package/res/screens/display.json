                        {
                            "type": "templateRef",
                            "id": "schedule_day_friday",
                            "templateId": "menu_item",
                            "overrides": {
                                ".": {
                                    "events": [
                                        {
                                            "type": "clicked",
                                            "action": "settings.display.schedule.day.friday"
