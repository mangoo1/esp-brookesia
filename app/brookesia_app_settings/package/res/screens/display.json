                    "type": "container",
                    "id": "schedule_start_card",
                    "styleRefs": [
                        "app.card"
                    ],
                    "style": {
                        "padding": "18dp"
                    },
                    "layout": {
                        "type": "flex",
                        "flexFlow": "column",
                        "gap": "0dp"
                    },
                    "placement": {
                        "mode": "flow",
                        "width": "match",
                        "height": "wrap",
                        "alignSelf": "stretch"
                    },
                    "children": [
